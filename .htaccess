RewriteRule ^scheduled-deliveries$ page.php?id=8 [QSA]
RewriteRule ^weee-compliance-statement$ page.php?id=7 [QSA]
RewriteRule ^over-10-million-data-sheets$ page.php?id=6 [QSA]
