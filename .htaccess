RewriteRule ^manufacturer-([^/]+)$ manufacturer.php?m=$1 [QSA]
RewriteCond %{HTTP_HOST} ^intransittech\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.intransittech\.com$
RewriteRule ^about\-us$ "https\:\/\/intransittech\.com\/about" [R=301,L]
RewriteCond %{HTTP_HOST} ^intransittech\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.intransittech\.com$
RewriteRule ^contact\-us$ "https\:\/\/intransittech\.com\/contact" [R=301,L]
RewriteCond %{HTTP_HOST} ^intransittech\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.intransittech\.com$
RewriteRule ^index$ "https\:\/\/intransittech\.com\/" [R=301,L]


